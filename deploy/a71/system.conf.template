#
# Installed to /etc/atlas/system.conf, owned by root, mode 0644, on a path whose
# every component is root-owned and not writable by anyone else. Atlas reaches it
# with `atlas_rootpath_open` — from `/`, refusing to traverse a single symbolic
# link — and treats anything else as absent. A policy an unprivileged uid could
# have written would constrain nobody, so Atlas would rather have none.
#
# This file turns on system mode. Without it Atlas is a per-user daemon that
# serves its own uid and nobody else, exactly as it was through A7.
#
# Syntax: `key = value`, one per line, `#` comments. No quoting, no escapes, no
# includes, no continuations. An unrecognised key is an error rather than
# something skipped: a policy Atlas half-understands is one whose author
# believes they configured something Atlas never read.

# Where the shared daemon listens. Its directory is created 0750 owned by the
# daemon's uid with the client group, and the socket 0660 with the same group —
# both set by Atlas and then read back, with the daemon refusing to start if the
# result is not exactly that.
socket_path = /run/atlas/atlas.sock

# The authoritative index. When this policy is active it is the *only* index a
# client resolves without an explicit --data-dir: ATLAS_DATA_DIR and $HOME stop
# selecting one, so a client that cannot reach the daemon fails instead of
# quietly opening the stale per-user database that A7.1 left in place.
data_dir = /var/lib/atlas

# The group the socket is handed to. Membership is what lets a process connect;
# it buys nothing else, because the protocol contains no method that approves,
# revalidates, registers, backs up, restores or prunes anything.
client_group = atlas-clients

# Uids permitted to connect, in addition to the daemon's own. Numeric, because
# this is compared against SO_PEERCRED, which is a number the kernel supplies —
# never a name a client could claim.
#
# Fill these in for the machine; they are deliberately absent from the template
# because a uid is machine-specific state and does not belong in the repository.
#
#   client_uid = <atlas-worker uid>
#   client_uid = <operator uid>
#
# uid 0 is rejected: root does not need the allowlist, and listing it would
# suggest the socket is a route to privilege.

# A9.2.4. Whether this daemon may keep a repository's *semantic* index current on
# its own initiative, for repositories about which no operator has said anything.
#
# ENABLED (the default when this key is absent) is the A9.2.4 reversal of
# A9.2.3's per-repository opt-in. The season's product rule is that semantic
# maintenance must not depend on an operator remembering to repair freshness —
# and what the opt-in protected was never code execution: libclang *parses*
# repository text, the compilation database's `command` string is word-split and
# never executed, arguments pass a positive allowlist, include directories
# outside the repository are recorded and never opened, and the parse runs in a
# bounded child with an empty environment and an address-space ceiling. What it
# protected was authority and resource policy, which is what this key is.
#
# Set DISABLED on a machine where a compiler must not run unasked. It changes
# nothing for a repository whose operator has said something: an explicit
# `code sem-config REPO --auto` or `--no-auto` is honoured in either direction
# and is never overruled by this default.
#
# An unrecognised value is malformed and leaves the whole policy inactive, which
# is legacy per-user mode — the fail-closed direction.
#
#   semantic_auto_default = ENABLED
#   semantic_auto_default = DISABLED

# A12.1. Which files Atlas may read as project memory, and whether it may
# reconcile them into verification claims on its own initiative.
#
# `memory_source` is repeated, one line per source: `<CLASS>[@<repo>]:<path>`,
# where CLASS is REPO_FILE, REPO_DIR, EXTERNAL_FILE or EXTERNAL_DIR. A
# REPO_* path is repository-relative and is read by the daemon through the
# same access A13 built. An EXTERNAL_* path is absolute and outside every
# registered repository; the daemon never opens it itself — an operator
# reads it and hands the bytes to the daemon through `atlas memory scan`.
# The optional `@<repo>` scopes a line to one registered repository by name;
# without it, the source applies to every registered repository. At most 16
# `memory_source` lines; a 17th is malformed, not silently dropped.
#
#   memory_source = REPO_FILE:CLAUDE.md
#   memory_source = REPO_DIR:.claude/memories
#   memory_source = EXTERNAL_FILE:/home/example/.claude/CLAUDE.md
#   memory_source = EXTERNAL_DIR@atlas:/home/example/.claude/projects/-opt-atlas/memory
#
# `memory_reconcile` decides whether Atlas may turn a registered source into
# verification claims on its own initiative, on the watcher's own tick,
# rather than only when an operator asks for it directly. ENABLED or
# DISABLED, at most once — stating it twice is malformed, because two lines
# disagreeing about whether an automatic pass runs is a policy nobody can
# read back correctly. Absent resolves to the compiled-in default, which is
# DISABLED: reading files and writing claims automatically is left off until
# an operator turns it on, unlike `semantic_auto_default` above.
#
#   memory_reconcile = ENABLED
#   memory_reconcile = DISABLED
